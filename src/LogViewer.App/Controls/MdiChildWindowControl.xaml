<UserControl x:Class="LogViewer.App.Controls.MdiChildWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="{DynamicResource Theme.BorderColor}" BorderThickness="1" Background="{DynamicResource Theme.LogBackground}"
            MouseLeftButtonDown="OnChildMouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Thumb x:Name="DragThumb" Grid.Row="0" DragDelta="OnDragThumbDragDelta" Cursor="SizeAll">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Background" Value="{Binding CustomColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CustomColorHex}" Value="{x:Null}">
                                            <Setter Property="Background" Value="{DynamicResource Theme.TitleBarBackground}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}" Foreground="White"
                                       VerticalAlignment="Center" Margin="6,0" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Content="▢" Width="24" Click="OnMaximizeRestoreClick"
                                    ToolTip="Maximize / Restore" Focusable="False" />
                            <Button Grid.Column="2" Content="✕" Width="24" Click="OnCloseClick"
                                    ToolTip="Close" Focusable="False" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <ContentPresenter Grid.Row="1" Content="{Binding}" />

            <Thumb x:Name="ResizeThumb" Grid.Row="1" Width="14" Height="14"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" DragDelta="OnResizeThumbDragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Path Data="M0,14 L14,14 L14,0 Z" Fill="{DynamicResource Theme.BorderColor}" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>
