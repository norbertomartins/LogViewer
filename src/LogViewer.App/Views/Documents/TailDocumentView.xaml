<UserControl x:Class="LogViewer.App.Views.Documents.TailDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:LogViewer.App.Models"
             xmlns:controls="clr-namespace:LogViewer.App.Controls"
             xmlns:converters="clr-namespace:LogViewer.App.Converters">
    <UserControl.Resources>
        <!-- Column widths are Auto + SharedSizeGroup (scoped via IsSharedSizeScope on LineListView) rather
             than fixed pixel widths, so columns grow with LogFontSize instead of the text overflowing into
             neighboring columns at larger sizes. Groups are shared between the plain and structured templates
             so Bookmark/LineNumber stay aligned even when a structured document falls back to plain rows. -->
        <DataTemplate x:Key="PlainLineTemplate" DataType="{x:Type models:LogLineViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LogCol.Bookmark" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LogCol.LineNumber" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding IsBookmarked, Converter={StaticResource BookmarkGlyphConverter}}" Margin="0,0,4,0" />
                <TextBlock Grid.Column="1" Text="{Binding LineNumber}" Opacity="0.6" Margin="0,0,8,0" />
                <TextBlock Grid.Column="2" Text="{Binding Text}">
                    <controls:InlinesHelper.Source>
                        <MultiBinding Converter="{StaticResource HighlightSpanInlinesConverter}">
                            <Binding Path="Text" />
                            <Binding Path="HighlightSpans" />
                            <Binding Path="DataContext.ShowHighlightMatchSpans"
                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                    </controls:InlinesHelper.Source>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StructuredLineTemplate" DataType="{x:Type models:LogLineViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LogCol.Bookmark" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LogCol.LineNumber" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LogCol.Timestamp" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LogCol.Level" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LogCol.ThreadId" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding IsBookmarked, Converter={StaticResource BookmarkGlyphConverter}}" Margin="0,0,4,0" />
                <TextBlock Grid.Column="1" Text="{Binding LineNumber}" Opacity="0.6" Margin="0,0,8,0" />
                <TextBlock Grid.Column="2" Text="{Binding Structured.Timestamp, Converter={StaticResource TimestampToLocalTimeConverter}}" Opacity="0.8" Margin="0,0,8,0" />
                <TextBlock Grid.Column="3" Text="{Binding Structured.Level}" FontWeight="Bold" Margin="0,0,8,0"
                           Foreground="{Binding Structured.Level, Converter={StaticResource LevelToBrushConverter}}" />
                <TextBlock Grid.Column="4" Text="{Binding ThreadId}" Opacity="0.6" Margin="0,0,8,0" />
                <!-- Column 5: rendered message — colorized when the converter produces inlines,
                     plain text otherwise (no template, or colorization disabled). Margin guarantees a
                     visible gap after Level/ThreadId even when their columns are exactly as wide as the text.
                     Highlight Background/Foreground are applied here rather than on the row (see
                     ItemContainerStyle below) so a highlight's background doesn't wash over the Level
                     column's own color-coded foreground. -->
                <TextBlock Grid.Column="5" Text="{Binding Structured.RenderedMessage}" Margin="4,0,0,0"
                           Background="{Binding Background}" Foreground="{Binding Foreground}">
                    <controls:InlinesHelper.Source>
                        <MultiBinding Converter="{StaticResource StructuredInlinesConverter}">
                            <Binding Path="Structured" />
                            <Binding Path="DataContext.IsColorizeStructuredValues"
                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                    </controls:InlinesHelper.Source>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <controls:LogLineTemplateSelector x:Key="LineTemplateSelector"
                                           PlainTemplate="{StaticResource PlainLineTemplate}"
                                           StructuredTemplate="{StaticResource StructuredLineTemplate}" />

        <converters:DetailPanelRowHeightConverter x:Key="DetailPanelRowHeightConverter" />

        <!-- Shared by the detail Border and its GridSplitter so both collapse together when the selected
             line has no structured detail to show — a splitter for a hidden panel would be confusing. -->
        <Style x:Key="CollapseWhenNoStructuredDetailStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedLine.Structured}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="DetailPanelRow" MinHeight="0">
                <RowDefinition.Height>
                    <MultiBinding Converter="{StaticResource DetailPanelRowHeightConverter}">
                        <Binding Path="DetailPanelHeight" />
                        <Binding Path="SelectedLine.Structured" />
                    </MultiBinding>
                </RowDefinition.Height>
            </RowDefinition>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0" Background="{DynamicResource Theme.LogBackground}" Foreground="{DynamicResource Theme.LogForeground}">
            <!-- Compact icon toolbar. Every control keeps a descriptive ToolTip and an
                 AutomationProperties.Name so screen readers and UI-automation tests still identify it. -->
            <ToolBar.Resources>
                <Style x:Key="IconButton" TargetType="ButtonBase">
                    <Setter Property="MinWidth" Value="30" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Padding" Value="4,2" />
                </Style>
            </ToolBar.Resources>

            <ToggleButton Content="⤓" Style="{StaticResource IconButton}" IsChecked="{Binding IsFollowingTail}"
                          AutomationProperties.Name="Follow Tail" ToolTip="Follow the tail (auto-scroll to newest line)" />
            <ToggleButton Content="☰" Style="{StaticResource IconButton}" IsChecked="{Binding IsStructuredView}"
                          AutomationProperties.Name="Structured View"
                          ToolTip="{Binding StructuredFormatName, StringFormat='Structured view ({0}) — Time/Level/Message columns + property details'}" />
            <ComboBox ItemsSource="{Binding AvailableStructuredFormats}" SelectedItem="{Binding StructuredFormatId}" Width="86"
                      AutomationProperties.Name="Structured format"
                      ToolTip="{Binding StructuredFormatName, StringFormat='Structured format: {0}. Auto-detected on open; change to override.'}"
                      Visibility="{Binding IsStructuredView, Converter={StaticResource BoolToVisibilityConverter}}" />
            <ToggleButton Content="🎨" Style="{StaticResource IconButton}" IsChecked="{Binding IsColorizeStructuredValues}"
                          AutomationProperties.Name="Colorize values" ToolTip="Highlight variable values in the message with distinct colors"
                          Visibility="{Binding IsStructuredView, Converter={StaticResource BoolToVisibilityConverter}}" />
            <ComboBox ItemsSource="{Binding LevelOptions}" SelectedItem="{Binding MinLevel}" Width="96"
                      AutomationProperties.Name="Minimum level" ToolTip="Only show lines at or above this severity"
                      Visibility="{Binding IsStructuredView, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Separator />
            <Button Content="🔖" Style="{StaticResource IconButton}" Command="{Binding ToggleBookmarkCommand}"
                    AutomationProperties.Name="Toggle bookmark" ToolTip="Toggle bookmark on the selected line (Ctrl+F2)" />
            <Button Content="🔖▲" Style="{StaticResource IconButton}" Command="{Binding PreviousBookmarkCommand}"
                    AutomationProperties.Name="Previous bookmark" ToolTip="Previous bookmark (Shift+F2)" />
            <Button Content="🔖▼" Style="{StaticResource IconButton}" Command="{Binding NextBookmarkCommand}"
                    AutomationProperties.Name="Next bookmark" ToolTip="Next bookmark (F2)" />
            <Separator />
            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="2,0,3,0" />
            <TextBox Width="140" VerticalAlignment="Center"
                     AutomationProperties.Name="Text filter"
                     Text="{Binding TextFilterPattern, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                     ToolTip="Show only lines matching this text/regex (live). Applies to the raw line in both plain and structured view." />
            <ToggleButton Content=".*" Style="{StaticResource IconButton}" IsChecked="{Binding TextFilterIsRegex}"
                          AutomationProperties.Name="Regex filter" ToolTip="Treat the filter as a regular expression" />
            <ToggleButton Content="Aa" Style="{StaticResource IconButton}" IsChecked="{Binding TextFilterCaseSensitive}"
                          AutomationProperties.Name="Case-sensitive filter" ToolTip="Case-sensitive filter" />
            <ToggleButton Content="🚫" Style="{StaticResource IconButton}" IsChecked="{Binding TextFilterExclude}"
                          AutomationProperties.Name="Exclude filter" ToolTip="Hide matching lines instead of showing only them" />
            <Button Content="✕" Style="{StaticResource IconButton}" Command="{Binding ClearTextFilterCommand}"
                    AutomationProperties.Name="Clear filter" ToolTip="Clear the text filter"
                    Visibility="{Binding IsTextFilterActive, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Separator />
            <Button Content="🖍▲" Style="{StaticResource IconButton}" Command="{Binding PreviousHighlightCommand}"
                    AutomationProperties.Name="Previous highlight" ToolTip="Previous highlighted line (Shift+F3)" />
            <Button Content="🖍▼" Style="{StaticResource IconButton}" Command="{Binding NextHighlightCommand}"
                    AutomationProperties.Name="Next highlight" ToolTip="Next highlighted line (F3)" />
            <Separator />
            <Menu Background="Transparent">
                <MenuItem Header="⚙" FontSize="13" AutomationProperties.Name="Run tool" ToolTip="Run an external tool on the selected line"
                          ItemsSource="{Binding ExternalTools}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Name}" />
                            <Setter Property="Command" Value="{Binding RelativeSource={RelativeSource AncestorType=Menu}, Path=DataContext.RunExternalToolCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </Menu>
            <Button Content="🔎" Style="{StaticResource IconButton}" Command="{Binding SearchCommand}"
                    AutomationProperties.Name="Search" ToolTip="Search the whole file / channel (Ctrl+Shift+F)" />
            <Button Content="💾" Style="{StaticResource IconButton}" Command="{Binding ExportVisibleCommand}"
                    AutomationProperties.Name="Export" ToolTip="Save the currently visible (filtered) lines to a file" />
            <ToggleButton Content="📊" Style="{StaticResource IconButton}" IsChecked="{Binding ShowTimeline}"
                          AutomationProperties.Name="Timeline" ToolTip="Show a volume-over-time histogram of the visible timestamped lines" />
            <Button Content="🖌" Style="{StaticResource IconButton}" Command="{Binding CustomizeCommand}"
                    AutomationProperties.Name="Customize" ToolTip="Customize this document's tab color and icon" />
            <Separator />
            <Button Content="⤓ New lines — resume follow" Command="{Binding ResumeFollowCommand}"
                    AutomationProperties.Name="Resume follow"
                    Visibility="{Binding HasUnseenChanges, Converter={StaticResource BoolToVisibilityConverter}}" />
        </ToolBar>

        <!-- Volume timeline: one bar per time bucket (error red / warning amber / info accent), click to
             jump to the first line in that bucket. Only timestamped lines contribute. -->
        <Border Grid.Row="1" x:Name="TimelineStrip"
                Background="{DynamicResource Theme.LogBackground}"
                BorderBrush="{DynamicResource Theme.BorderColor}" BorderThickness="0,0,0,1" Padding="4,2"
                Visibility="{Binding ShowTimeline, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Height="52">
                <TextBlock Text="No timestamped lines to chart" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding TimelineHasData, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                <ItemsControl ItemsSource="{Binding VolumeBins}"
                              AutomationProperties.AutomationId="TimelineStrip" AutomationProperties.Name="Volume timeline">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectBinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,1,0"
                                    VerticalContentAlignment="Bottom" Cursor="Hand">
                                <Button.ToolTip>
                                    <TextBlock>
                                        <Run Text="{Binding Start, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}', Mode=OneWay}" /><LineBreak />
                                        <Run Text="{Binding Total, StringFormat='{}{0} lines', Mode=OneWay}" />
                                        <Run Text="{Binding Warnings, StringFormat=' · {0} warn', Mode=OneWay}" />
                                        <Run Text="{Binding Errors, StringFormat=' · {0} err', Mode=OneWay}" />
                                    </TextBlock>
                                </Button.ToolTip>
                                <StackPanel VerticalAlignment="Bottom">
                                    <Rectangle Fill="#E53935" HorizontalAlignment="Stretch">
                                        <Rectangle.Height>
                                            <MultiBinding Converter="{StaticResource VolumeBinBarHeightConverter}" ConverterParameter="44">
                                                <Binding Path="Errors" />
                                                <Binding Path="DataContext.MaxBinTotal" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            </MultiBinding>
                                        </Rectangle.Height>
                                    </Rectangle>
                                    <Rectangle Fill="#FFB300" HorizontalAlignment="Stretch">
                                        <Rectangle.Height>
                                            <MultiBinding Converter="{StaticResource VolumeBinBarHeightConverter}" ConverterParameter="44">
                                                <Binding Path="Warnings" />
                                                <Binding Path="DataContext.MaxBinTotal" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            </MultiBinding>
                                        </Rectangle.Height>
                                    </Rectangle>
                                    <Rectangle Fill="{DynamicResource Theme.LogForeground}" Opacity="0.55" HorizontalAlignment="Stretch">
                                        <Rectangle.Height>
                                            <MultiBinding Converter="{StaticResource VolumeBinBarHeightConverter}" ConverterParameter="44">
                                                <Binding Path="Info" />
                                                <Binding Path="DataContext.MaxBinTotal" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            </MultiBinding>
                                        </Rectangle.Height>
                                    </Rectangle>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <ListView Grid.Row="2" x:Name="LineListView"
                  ItemsSource="{Binding Lines}"
                  SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  Padding="0,0,0,16"
                  Grid.IsSharedSizeScope="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  Style="{StaticResource LogListViewStyle}"
                  FontFamily="Consolas" FontSize="{Binding LogFontSize}"
                  PreviewMouseWheel="OnLineListPreviewMouseWheel">
            <ListView.ItemContainerStyle>
                <!-- Tag carries the document view-model down to the row's ContextMenu: a ContextMenu opens in
                     its own popup tree, so an ElementName binding back to LineListView is not reliable across
                     that boundary — PlacementTarget.Tag/.DataContext (read directly off the clicked
                     ListViewItem, no popup-crossing tree-walk involved) is. -->
                <Style TargetType="ListViewItem" BasedOn="{StaticResource LogListViewItemStyle}">
                    <Setter Property="Background" Value="{Binding Background}" />
                    <Setter Property="Foreground" Value="{Binding Foreground}" />
                    <Setter Property="Tag" Value="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext}" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Filter by TraceId"
                                          Command="{Binding PlacementTarget.Tag.FilterByTraceIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Filter by SpanId"
                                          Command="{Binding PlacementTarget.Tag.FilterBySpanIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Filter by ThreadId"
                                          Command="{Binding PlacementTarget.Tag.FilterByThreadIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Find Similar Block In..."
                                          Command="{Binding PlacementTarget.Tag.FindSimilarBlockCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Clear Filter"
                                          Command="{Binding PlacementTarget.Tag.ClearFilterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- Structured rows apply the highlight's Background/Foreground on the message
                             TextBlock only (StructuredLineTemplate above); keep the row itself on the
                             theme default so Bookmark/LineNumber/Timestamp/Level/ThreadId aren't tinted. -->
                        <DataTrigger Binding="{Binding HasStructured}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Theme.LogBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource Theme.LogForeground}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplateSelector>
                <StaticResource ResourceKey="LineTemplateSelector" />
            </ListView.ItemTemplateSelector>
        </ListView>

        <!-- Drag to resize the detail panel below; hidden together with it (via the shared style) when the
             selected line has no structured detail. DragCompleted (code-behind) persists the resulting
             height onto the view-model, which the DetailPanelRow height MultiBinding feeds right back. -->
        <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="5"
                      Background="{DynamicResource Theme.BorderColor}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Cursor="SizeNS" Style="{StaticResource CollapseWhenNoStructuredDetailStyle}"
                      DragCompleted="OnDetailPanelSplitterDragCompleted" />

        <!-- Structured-log detail: timestamp/template/properties/exception for the selected line, when it
             parsed as Serilog JSON. Collapses entirely for plain-text lines/documents. -->
        <Border Grid.Row="4" Background="{DynamicResource Theme.LogBackground}" TextElement.Foreground="{DynamicResource Theme.LogForeground}"
                BorderBrush="{DynamicResource Theme.BorderColor}" BorderThickness="0,1,0,0" Padding="8"
                Style="{StaticResource CollapseWhenNoStructuredDetailStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding SelectedLine.Structured}">
                    <TextBlock Text="{Binding Timestamp, StringFormat='Timestamp: {0:yyyy-MM-dd HH:mm:ss.fff zzz}'}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding MessageTemplate, StringFormat='Template: {0}'}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Visibility="{Binding MessageTemplate, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                    <TextBlock Text="Properties" FontWeight="Bold" Margin="0,0,0,2" />
                    <ItemsControl ItemsSource="{Binding Properties}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,1"
                                      Tag="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Filter by this value"
                                                      Command="{Binding PlacementTarget.Tag.FilterByPropertyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Exception" FontWeight="Bold" Margin="0,8,0,2"
                               Visibility="{Binding Exception, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                    <TextBox Text="{Binding Exception, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" FontSize="11" AcceptsReturn="True" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Visibility="{Binding Exception, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StatusBar Grid.Row="5" Background="{DynamicResource Theme.LogBackground}" Foreground="{DynamicResource Theme.LogForeground}">
            <StatusBar.Template>
                <ControlTemplate TargetType="StatusBar">
                    <Border Background="{TemplateBinding Background}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </StatusBar.Template>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding FilterStatusText}" Margin="0,0,8,0" />
                    <Button Content="✕ Clear filter" Command="{Binding ClearFilterCommand}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
