<UserControl x:Class="LogViewer.App.Views.Documents.TimelineStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LogViewer.App.Localization">
    <!-- DataContext: the TailDocumentViewModel (inherited from TailDocumentView). -->
    <!-- Volume timeline: one bar per time bucket (error red / warning amber / info accent), click to
         jump to the first line in that bucket. Only timestamped lines contribute. -->
    <Border x:Name="TimelineStrip"
            Background="{DynamicResource Theme.LogBackground}"
            BorderBrush="{DynamicResource Theme.BorderColor}" BorderThickness="0,0,0,1" Padding="4,2"
            Visibility="{Binding ShowTimeline, Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid Height="52">
            <TextBlock Text="{loc:Loc Doc_Timeline_NoData}" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding TimelineHasData, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            <ItemsControl ItemsSource="{Binding VolumeBins}"
                          AutomationProperties.AutomationId="TimelineStrip" AutomationProperties.Name="{loc:Loc Doc_Timeline_Name2}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- The Rectangles have no explicit width, so the Button must fill its UniformGrid cell and
                             stretch its content: Fluent's Button style defaults to HorizontalAlignment=Left and
                             HorizontalContentAlignment=Center, which collapsed every bar to 0px wide. -->
                        <Button Command="{Binding DataContext.SelectBinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,1,0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Bottom" Cursor="Hand"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc Doc_Timeline_FilterToBin}"
                                              Command="{Binding PlacementTarget.Tag.FilterToBinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:Loc Doc_Time_ClearRange}"
                                              Command="{Binding PlacementTarget.Tag.ClearTimeFilterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Button.ToolTip>
                                <StackPanel>
                                    <TextBlock>
                                        <Run Text="{Binding Start, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}', Mode=OneWay}" /><LineBreak />
                                        <Run Text="{Binding Total, StringFormat={loc:Loc Doc_Timeline_Tip_Lines}, Mode=OneWay}" />
                                        <Run Text="{Binding Warnings, StringFormat={loc:Loc Doc_Timeline_Tip_Warn}, Mode=OneWay}" />
                                        <Run Text="{Binding Errors, StringFormat={loc:Loc Doc_Timeline_Tip_Err}, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{loc:Loc Doc_Timeline_VolumeSpike}" Foreground="#D81B60" FontWeight="Bold"
                                               Visibility="{Binding IsVolumeSpike, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="{loc:Loc Doc_Timeline_ErrorSpike}" Foreground="#D81B60" FontWeight="Bold"
                                               Visibility="{Binding IsErrorSpike, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Button.ToolTip>
                            <StackPanel VerticalAlignment="Bottom">
                                <!-- Anomaly marker: a thin magenta cap on bins far above the recent baseline. -->
                                <Rectangle Fill="#D81B60" Height="3" Margin="0,0,0,1" HorizontalAlignment="Stretch"
                                           Visibility="{Binding IsSpike, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Rectangle Fill="#E53935" HorizontalAlignment="Stretch">
                                    <Rectangle.Height>
                                        <MultiBinding Converter="{StaticResource VolumeBinBarHeightConverter}" ConverterParameter="44">
                                            <Binding Path="Errors" />
                                            <Binding Path="DataContext.MaxBinTotal" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </Rectangle.Height>
                                </Rectangle>
                                <Rectangle Fill="#FFB300" HorizontalAlignment="Stretch">
                                    <Rectangle.Height>
                                        <MultiBinding Converter="{StaticResource VolumeBinBarHeightConverter}" ConverterParameter="44">
                                            <Binding Path="Warnings" />
                                            <Binding Path="DataContext.MaxBinTotal" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </Rectangle.Height>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Theme.LogForeground}" Opacity="0.55" HorizontalAlignment="Stretch">
                                    <Rectangle.Height>
                                        <MultiBinding Converter="{StaticResource VolumeBinBarHeightConverter}" ConverterParameter="44">
                                            <Binding Path="Info" />
                                            <Binding Path="DataContext.MaxBinTotal" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </Rectangle.Height>
                                </Rectangle>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
