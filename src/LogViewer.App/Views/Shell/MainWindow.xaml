<Window x:Class="LogViewer.App.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xcad="https://github.com/Dirkster99/AvalonDock"
        xmlns:vm="clr-namespace:LogViewer.App.ViewModels"
        xmlns:views="clr-namespace:LogViewer.App.Views.Documents"
        xmlns:shell="clr-namespace:LogViewer.App.Views.Shell"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="{Binding WindowTitle}"
        Height="700" Width="1100"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="F3" Command="{Binding ActiveDocument.NextHighlightCommand}" />
        <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding ActiveDocument.PreviousHighlightCommand}" />
        <KeyBinding Key="F2" Command="{Binding ActiveDocument.NextBookmarkCommand}" />
        <KeyBinding Key="F2" Modifiers="Shift" Command="{Binding ActiveDocument.PreviousBookmarkCommand}" />
        <KeyBinding Key="F2" Modifiers="Control" Command="{Binding ActiveDocument.ToggleBookmarkCommand}" />
        <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding ActiveDocument.SearchCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <tb:TaskbarIcon x:Name="TrayIcon"
                         ToolTipText="LogViewer"
                         TrayMouseDoubleClick="OnTrayShowClick"
                         Visibility="Collapsed">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show LogViewer" Click="OnTrayShowClick" FontWeight="Bold" />
                    <Separator />
                    <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open File..." Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="Open _Directory (Watch)..." Command="{Binding OpenDirectoryWatchCommand}" />
                <MenuItem Header="Open _Merged Files (by time)..." Command="{Binding OpenMergedFilesCommand}"
                          ToolTip="Pick 2+ files to tail together, interleaved by timestamp" />
                <MenuItem Header="Open _Windows Event Log..." Command="{Binding OpenEventLogCommand}" />
                <MenuItem Header="Open _Remote Log Endpoint..." Command="{Binding OpenRemoteEndpointCommand}"
                          ToolTip="Tail a log stream over HTTP(S) (SSE/chunked/polled) or a WebSocket" />
                <MenuItem Header="Open _Command Output..." Command="{Binding OpenProcessTailCommand}"
                          ToolTip="Tail the stdout/stderr of a command (journalctl -f, docker logs -f, …)" />
                <MenuItem Header="Open S_SH Log Tail..." Command="{Binding OpenSshTailCommand}"
                          ToolTip="Run a command over SSH on a remote host and tail its output" />
                <MenuItem Header="Open _ETW Provider..." Command="{Binding OpenEtwTailCommand}"
                          ToolTip="Tail a real-time Event Tracing for Windows provider (Administrator)" />
                <MenuItem Header="Recent Files" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Path}" />
                            <Setter Property="Command" Value="{Binding RelativeSource={RelativeSource AncestorType=Menu}, Path=DataContext.OpenRecentFileCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding Path}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="Mi_nimize to Tray" Click="OnMinimizeToTrayClick" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Window Mode">
                <MenuItem Header="_Tabbed" Command="{Binding SwitchWindowModeCommand}" CommandParameter="Tabbed" />
                <MenuItem Header="_Floating" Command="{Binding SwitchWindowModeCommand}" CommandParameter="Floating" />
                <MenuItem Header="_MDI" Command="{Binding SwitchWindowModeCommand}" CommandParameter="Mdi" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Highlight Presets..." Command="{Binding EditHighlightPresetsCommand}" />
                <MenuItem Header="_Toggle Highlight Presets" ItemsSource="{Binding HighlightPresetToggles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Name}" />
                            <Setter Property="IsCheckable" Value="True" />
                            <Setter Property="IsChecked" Value="{Binding IsEnabled, Mode=TwoWay}" />
                            <Setter Property="StaysOpenOnClick" Value="True" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="External _Tools..." Command="{Binding EditExternalToolsCommand}" />
                <MenuItem Header="_Windows Services..." Command="{Binding OpenServicesCommand}" />
                <MenuItem Header="_Settings..." Command="{Binding OpenSettingsCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <xcad:DockingManager x:Name="DockManager"
                                  DocumentsSource="{Binding Documents}"
                                  ActiveContent="{Binding ActiveDocument, Mode=TwoWay}"
                                  Visibility="{Binding Host.IsMdiMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <!-- Without an explicit Theme, AvalonDock relies on its assembly's own Generic.xaml being
                     auto-resolved as the default style for its controls — which silently breaks under WPF's
                     Fluent ThemeMode (see ThemeService), leaving some AvalonDock control templates only
                     partially applied. That's what crashed floating-window dragging: OverlayWindow.OnApplyTemplate
                     found several named template parts null (their template never really applied) and NREd the
                     moment a float drag asked it to show drop-target indicators. GenericTheme merges AvalonDock's
                     resource dictionary explicitly instead of relying on that auto-resolution. -->
                <xcad:DockingManager.Theme>
                    <xcad:GenericTheme />
                </xcad:DockingManager.Theme>
                <xcad:DockingManager.Resources>
                    <!-- GenericTheme's own ContextMenuEx/MenuItemEx templates (the tab's right-click
                         Float/Dock/Close popup, and the "hidden tabs" overflow list) are baked into
                         AvalonDock's generic.xaml with hardcoded light colors — they don't read
                         Application.ThemeMode or the SystemColors overrides ThemeService applies for every
                         other menu/popup in the app. Re-templating them here (added directly to this
                         Resources dictionary, so it wins over the dictionary GenericTheme merges in)
                         reuses those same SystemColors brushes so these popups repaint with the rest of
                         the app when the theme changes. -->
                    <Style TargetType="{x:Type xcad:ContextMenuEx}">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type xcad:ContextMenuEx}">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <ScrollViewer CanContentScroll="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="{x:Type xcad:MenuItemEx}">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}" />
                        <Setter Property="Padding" Value="4,3" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type xcad:MenuItemEx}">
                                    <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            BorderThickness="0"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="16" />
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="CheckMark"
                                                  Grid.Column="0"
                                                  Width="8" Height="8"
                                                  Margin="4,0,0,0"
                                                  Stretch="Fill"
                                                  Visibility="Collapsed"
                                                  Fill="{TemplateBinding Foreground}"
                                                  Data="M0,4 L3,7 L8,0" />
                                            <ContentPresenter Grid.Column="1"
                                                              Margin="{TemplateBinding Padding}"
                                                              VerticalAlignment="Center"
                                                              ContentSource="Header"
                                                              RecognizesAccessKey="True" />
                                            <TextBlock Grid.Column="2"
                                                       Margin="8,0,4,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       Text="{TemplateBinding InputGestureText}" />
                                            <Path x:Name="SubmenuArrow"
                                                  Grid.Column="3"
                                                  Width="8" Height="8"
                                                  VerticalAlignment="Center"
                                                  Stretch="Uniform"
                                                  Visibility="Collapsed"
                                                  Fill="{TemplateBinding Foreground}"
                                                  Data="M0,0 L4,4 L0,8 Z" />
                                            <Popup x:Name="Popup"
                                                   AllowsTransparency="True"
                                                   Focusable="False"
                                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                                   Placement="Right"
                                                   PopupAnimation="Fade">
                                                <Border Background="{DynamicResource {x:Static SystemColors.MenuBrushKey}}"
                                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                                        BorderThickness="1">
                                                    <ScrollViewer CanContentScroll="True">
                                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="Role" Value="SubmenuHeader">
                                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </xcad:DockingManager.Resources>
                <xcad:DockingManager.LayoutItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TailDocumentViewModel}">
                        <views:TailDocumentView />
                    </DataTemplate>
                </xcad:DockingManager.LayoutItemTemplate>
                <xcad:DockingManager.LayoutItemContainerStyle>
                    <Style TargetType="{x:Type xcad:LayoutItem}">
                        <!-- AvalonDock's LayoutItem exposes no Background/Foreground styling surface for tab
                             headers, so per-document color customization can't repaint the tab itself the way
                             MdiChildWindowControl's title-bar does for MDI mode. An IconSource swatch is the
                             one header surface AvalonDock does render, so it carries the color in Tabbed mode. -->
                        <Setter Property="Title" Value="{Binding Model.DisplayTitle}" />
                        <Setter Property="ContentId" Value="{Binding Model.SourcePath}" />
                        <Setter Property="IconSource" Value="{Binding Model.CustomColorHex, Converter={StaticResource HexToTabIconConverter}}" />
                    </Style>
                </xcad:DockingManager.LayoutItemContainerStyle>
                <xcad:LayoutRoot>
                    <xcad:LayoutPanel Orientation="Horizontal">
                        <xcad:LayoutDocumentPane />
                    </xcad:LayoutPanel>
                </xcad:LayoutRoot>
            </xcad:DockingManager>

            <shell:MdiHostView Visibility="{Binding Host.IsMdiMode, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
    </DockPanel>
</Window>
