<UserControl x:Class="LogViewer.App.Views.Shell.MdiHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LogViewer.App.Controls">
    <Grid Background="{DynamicResource Theme.WorkspaceBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0">
            <Button Content="Cascade" Click="OnCascadeClick" />
            <Button Content="Tile Horizontal" Click="OnTileHorizontalClick" />
            <Button Content="Tile Vertical" Click="OnTileVerticalClick" />
        </ToolBar>

        <ScrollViewer x:Name="MdiScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="MdiCanvas" Width="4000" Height="3000" Background="Transparent">
                <ItemsControl ItemsSource="{Binding Documents}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding MdiLeft, Mode=OneWay}" />
                            <Setter Property="Canvas.Top" Value="{Binding MdiTop, Mode=OneWay}" />
                            <Setter Property="Panel.ZIndex" Value="{Binding MdiZIndex, Mode=OneWay}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:MdiChildWindowControl Width="{Binding MdiWidth, Mode=OneWay}" Height="{Binding MdiHeight, Mode=OneWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </ScrollViewer>
    </Grid>
</UserControl>
