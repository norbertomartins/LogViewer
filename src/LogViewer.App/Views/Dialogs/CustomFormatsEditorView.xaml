<Window x:Class="LogViewer.App.Views.Dialogs.CustomFormatsEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LogViewer.App.Localization"
        Title="{loc:Loc Formats_Title}"
        Width="1040" Height="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Left: the list of formats -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{loc:Loc Formats_Add}" Command="{Binding AddFormatCommand}" Padding="8,2" Margin="0,0,4,0" />
                    <Button Content="{loc:Loc Formats_Duplicate}" Command="{Binding DuplicateFormatCommand}" Padding="8,2" Margin="0,0,4,0" />
                    <Button Content="{loc:Loc Formats_Remove}" Command="{Binding RemoveFormatCommand}" Padding="8,2" />
                </StackPanel>
                <TextBlock Text="{loc:Loc Formats_FromExample}" Margin="0,8,0,2" />
                <ComboBox x:Name="ExamplePicker" ItemsSource="{Binding Examples}" DisplayMemberPath="Name"
                          SelectionChanged="OnExampleSelected" AutomationProperties.Name="{loc:Loc Formats_FromExample}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" DisplayMemberPath="Name"
                     AutomationProperties.AutomationId="CustomFormatsList" />
        </DockPanel>

        <!-- Right: editor for the selected format + live sample preview -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="{loc:Loc Formats_Name}" VerticalAlignment="Center" Margin="0,0,8,4" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                     Text="{Binding SelectedFormat.Name, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{loc:Loc Formats_Name}" />

            <TextBlock Grid.Row="1" Text="{loc:Loc Formats_Pattern}" VerticalAlignment="Top" Margin="0,2,8,4" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,2" FontFamily="Consolas" TextWrapping="Wrap" MinHeight="54"
                     AcceptsReturn="False"
                     Text="{Binding SelectedFormat.Pattern, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                     AutomationProperties.Name="{loc:Loc Formats_Pattern}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedFormat.Error}" Foreground="#C0392B" TextWrapping="Wrap"
                       Visibility="{Binding SelectedFormat.Error, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{loc:Loc Formats_GroupsHint}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,6" />

            <TextBlock Grid.Row="4" Text="{loc:Loc Formats_TimestampFormat}" VerticalAlignment="Center" Margin="0,0,8,4" />
            <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,4">
                <CheckBox DockPanel.Dock="Right" Content="{loc:Loc Formats_IgnoreCase}" IsChecked="{Binding SelectedFormat.IgnoreCase}"
                          VerticalAlignment="Center" Margin="12,0,0,0" />
                <CheckBox DockPanel.Dock="Right" Content="{loc:Loc Formats_JoinContinuation}" IsChecked="{Binding SelectedFormat.JoinContinuationLines}"
                          VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="{loc:Loc Formats_JoinContinuation_ToolTip}" />
                <CheckBox DockPanel.Dock="Right" Content="{loc:Loc Formats_Utc}" IsChecked="{Binding SelectedFormat.TimestampIsUtc}"
                          VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="{loc:Loc Formats_Utc_ToolTip}" />
                <TextBox FontFamily="Consolas" Text="{Binding SelectedFormat.TimestampFormat, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                         ToolTip="{loc:Loc Formats_TimestampFormat_ToolTip}" AutomationProperties.Name="{loc:Loc Formats_TimestampFormat}" />
            </DockPanel>

            <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="{loc:Loc Formats_Sample}" FontWeight="Bold" Margin="0,8,0,2" />
            <TextBox Grid.Row="6" Grid.ColumnSpan="2" FontFamily="Consolas" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Text="{Binding SampleText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                     AutomationProperties.Name="{loc:Loc Formats_Sample}" />
            <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="{Binding SampleSummary}" Margin="0,4,0,4" />
            <ListView Grid.Row="8" Grid.ColumnSpan="2" ItemsSource="{Binding SampleResults}"
                      AutomationProperties.AutomationId="CustomFormatSampleResults">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Matched}" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="✓" Width="30">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="✓" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Matched}" Value="False">
                                                        <Setter Property="Text" Value="✗" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{loc:Loc Formats_Col_Timestamp}" Width="200" DisplayMemberBinding="{Binding Timestamp}" />
                        <GridViewColumn Header="{loc:Loc Stats_Col_Level}" Width="90" DisplayMemberBinding="{Binding Level}" />
                        <GridViewColumn Header="{loc:Loc Exceptions_Col_Message}" Width="220" DisplayMemberBinding="{Binding Message}" />
                        <GridViewColumn Header="{loc:Loc Formats_Col_Properties}" Width="220" DisplayMemberBinding="{Binding Properties}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{loc:Loc Common_OK}" Width="90" Margin="0,0,6,0" IsDefault="True" Click="OnSaveClick"
                    IsEnabled="{Binding CanSave}" />
            <Button Content="{loc:Loc Common_Cancel}" Width="90" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
