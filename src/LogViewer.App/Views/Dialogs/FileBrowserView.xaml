<Window x:Class="LogViewer.App.Views.Dialogs.FileBrowserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:LogViewer.App.Models"
        xmlns:loc="clr-namespace:LogViewer.App.Localization"
        Title="{Binding Title, StringFormat={loc:Loc Browser_TitleFmt}}"
        Width="1000" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.LogBackground}"
        Foreground="{DynamicResource Theme.LogForeground}">
    <Window.InputBindings>
        <KeyBinding Key="F3" Command="{Binding FindNextCommand}" />
        <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding FindPreviousCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0" Background="{DynamicResource Theme.LogBackground}" Foreground="{DynamicResource Theme.LogForeground}">
            <TextBlock Text="{loc:Loc Browser_Line}" VerticalAlignment="Center" Margin="2,0,4,0" />
            <TextBox Width="110" VerticalAlignment="Center" FontFamily="Consolas" Style="{StaticResource ToolbarTextBoxStyle}"
                     Text="{Binding GoToLineText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{loc:Loc Browser_LineName}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding GoToLineCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="{loc:Loc Doc_Time_Go}" Command="{Binding GoToLineCommand}" MinWidth="40" />
            <Separator />
            <TextBlock Text="{loc:Loc Browser_Time}" VerticalAlignment="Center" Margin="2,0,4,0" />
            <TextBox Width="170" VerticalAlignment="Center" FontFamily="Consolas" Style="{StaticResource ToolbarTextBoxStyle}"
                     Text="{Binding GoToTimeText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{loc:Loc Doc_Time_Hint}"
                     AutomationProperties.Name="{loc:Loc Browser_TimeName}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding GoToTimeCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="{loc:Loc Doc_Time_Go}" Command="{Binding GoToTimeCommand}" MinWidth="40" />
            <Separator />
            <ToggleButton Content="⤓" MinWidth="30" IsChecked="{Binding FollowEnd}"
                          AutomationProperties.Name="{loc:Loc Browser_Follow}" ToolTip="{loc:Loc Browser_Follow}" />
            <Button Content="{loc:Loc Browser_ShowInDocument}" Command="{Binding ShowInDocumentCommand}"
                    ToolTip="{loc:Loc Browser_ShowInDocument_ToolTip}" />
            <Button Content="{loc:Loc Doc_Ctx_Copy}" Command="{Binding CopySelectedCommand}" />
            <Separator />
            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="2,0,3,0" />
            <TextBox Width="180" VerticalAlignment="Center" FontFamily="Consolas" Style="{StaticResource ToolbarTextBoxStyle}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{loc:Loc Browser_SearchName}" ToolTip="{loc:Loc Browser_Search_ToolTip}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding FindNextCommand}" />
                    <KeyBinding Key="Return" Modifiers="Shift" Command="{Binding FindPreviousCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <ToggleButton Content=".*" MinWidth="26" IsChecked="{Binding SearchIsRegex}"
                          AutomationProperties.Name="{loc:Loc Doc_RegexFilter_Name}" ToolTip="{loc:Loc Doc_RegexFilter_ToolTip}" />
            <ToggleButton Content="Aa" MinWidth="26" IsChecked="{Binding SearchCaseSensitive}"
                          AutomationProperties.Name="{loc:Loc Doc_CaseFilter_Name}" ToolTip="{loc:Loc Doc_CaseFilter_ToolTip}" />
            <Button Content="▲" MinWidth="26" Command="{Binding FindPreviousCommand}"
                    AutomationProperties.Name="{loc:Loc Browser_FindPrevious}" ToolTip="{loc:Loc Browser_FindPrevious}" />
            <Button Content="▼" MinWidth="26" Command="{Binding FindNextCommand}"
                    AutomationProperties.Name="{loc:Loc Browser_FindNext}" ToolTip="{loc:Loc Browser_FindNext}" />
            <Button Content="Σ" MinWidth="26" Command="{Binding CountMatchesCommand}"
                    AutomationProperties.Name="{loc:Loc Browser_CountMatches}" ToolTip="{loc:Loc Browser_CountMatches}" />
            <Button Content="✕" MinWidth="26" Command="{Binding CancelSearchCommand}"
                    AutomationProperties.Name="{loc:Loc Browser_CancelSearch}" ToolTip="{loc:Loc Browser_CancelSearch}"
                    Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Text="{Binding MatchCountText}" VerticalAlignment="Center" Margin="6,0,0,0" />
        </ToolBar>

        <!-- ScrollUnit="Item": pixel scrolling over millions of rows makes the thumb useless and forces WPF to
             estimate every row's height. VirtualFileLineList only materializes the pages the panel asks for. -->
        <ListView Grid.Row="1" x:Name="LineListView"
                  ItemsSource="{Binding Lines}"
                  SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Standard"
                  VirtualizingPanel.ScrollUnit="Item"
                  Style="{StaticResource LogListViewStyle}"
                  FontFamily="Consolas" FontSize="{Binding LogFontSize}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource LogListViewItemStyle}">
                    <Setter Property="Background" Value="{Binding Background}" />
                    <Setter Property="Foreground" Value="{Binding Foreground}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type models:LogLineViewModel}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LineNumber}" Opacity="0.6" MinWidth="70" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Text}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StatusBar Grid.Row="2" Background="{DynamicResource Theme.LogBackground}" Foreground="{DynamicResource Theme.LogForeground}">
            <StatusBarItem>
                <TextBlock Text="{Binding TotalLines, StringFormat={loc:Loc Browser_TotalLinesFmt}}" />
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressBar Width="160" Height="12" Minimum="0" Maximum="1" Value="{Binding IndexProgress}" />
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressBar Width="160" Height="12" Minimum="0" Maximum="1" Value="{Binding SearchProgress}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding FilePath}" Opacity="0.6" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
