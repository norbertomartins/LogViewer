<Window x:Class="LogViewer.App.Views.Dialogs.ServicesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LogViewer.App.Localization"
        Title="{loc:Loc Services_Title}"
        Width="620" Height="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="{loc:Loc Common_Refresh}" Width="80" Margin="0,0,6,0" Command="{Binding RefreshCommand}" />
            <Button Content="{loc:Loc Common_Start}" Width="80" Margin="0,0,6,0" Command="{Binding StartServiceCommand}" />
            <Button Content="{loc:Loc Common_Stop}" Width="80" Command="{Binding StopServiceCommand}" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc Services_Col_Name}" Binding="{Binding DisplayName}" Width="*" />
                <DataGridTextColumn Header="{loc:Loc Services_Col_Status}" Binding="{Binding Status}" Width="100" />
                <DataGridTextColumn Header="{loc:Loc Services_Col_StartType}" Binding="{Binding StartType}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,6,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{loc:Loc Common_Close}" Width="80" Click="OnCloseClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
