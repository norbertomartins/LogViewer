<Window x:Class="LogViewer.App.Views.Dialogs.DocumentCustomizeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customize Document"
        Width="360" Height="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Tab / title-bar color" Margin="0,0,0,4" />
            <ListBox ItemsSource="{Binding AvailableColors}" SelectedItem="{Binding SelectedColorHex, Mode=TwoWay}"
                     Margin="0,0,0,12">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="26" Height="26" Margin="2" BorderBrush="Black" BorderThickness="1"
                                Background="{Binding Converter={StaticResource HexToBrushConverter}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Icon glyph" Margin="0,0,0,4" />
            <ListBox ItemsSource="{Binding AvailableGlyphs}" SelectedItem="{Binding SelectedIconGlyph, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="16" Margin="4" MinWidth="20" TextAlignment="Center" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Margin="0,0,6,0" Click="OnOkClick" IsDefault="True" />
            <Button Content="Cancel" Width="80" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
