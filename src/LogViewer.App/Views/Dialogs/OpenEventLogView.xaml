<Window x:Class="LogViewer.App.Views.Dialogs.OpenEventLogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Windows Event Log"
        Width="640" Height="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Channel name" />
            <ComboBox Text="{Binding ChannelName, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding CommonChannels}"
                      IsEditable="True" />
            <TextBlock Text="Standard channels (Application, System) work without administrator rights. The Security channel and some custom channels require elevation."
                       TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Filters (optional)" FontWeight="Bold" Margin="0,0,0,4" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Add" Width="60" Margin="0,0,6,0" Command="{Binding AddFilterCommand}" />
                    <Button Content="Remove" Width="60" Command="{Binding RemoveFilterCommand}" CommandParameter="{Binding SelectedFilter}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Filters}"
                         SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                         DisplayMemberPath="Name" />
            </DockPanel>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          DataContext="{Binding SelectedFilter}">
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="Name" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                <TextBlock Text="Provider name (optional — leave blank to match any provider)" TextWrapping="Wrap" />
                <TextBox Text="{Binding ProviderName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                <TextBlock Text="Regex pattern" />
                <TextBox Text="{Binding RegexPattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                <TextBlock Text="Match against" />
                <ComboBox ItemsSource="{Binding AvailableFields}" SelectedItem="{Binding Field}" Margin="0,0,0,8" />

                <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled}" />
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Margin="0,0,6,0" Click="OnOkClick" IsDefault="True" />
            <Button Content="Cancel" Width="80" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
