<Window x:Class="LogViewer.App.Views.Dialogs.OpenEtwTailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LogViewer.App.Localization"
        Title="{loc:Loc Etw_Title}"
        Width="520" SizeToContent="Height"
        MinHeight="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:Loc Etw_AdminNote}" FontStyle="Italic" Opacity="0.8" Margin="0,0,0,8" TextWrapping="Wrap" />

            <TextBlock Text="{loc:Loc Etw_ProviderNameOrGuid}" />
            <ComboBox IsEditable="True" Text="{Binding Provider, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding Presets}" Margin="0,2,0,10" />

            <TextBlock Text="{loc:Loc Etw_Level}" />
            <ComboBox ItemsSource="{Binding LevelOptions}" SelectedItem="{Binding Level}"
                      Margin="0,2,0,4" HorizontalAlignment="Left" MinWidth="200" />
            <TextBlock Text="{loc:Loc Etw_LevelNote}"
                       FontStyle="Italic" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,10" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{loc:Loc Common_OK}" Width="80" Margin="0,0,6,0" Click="OnOkClick" IsDefault="True" />
            <Button Content="{loc:Loc Common_Cancel}" Width="80" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
