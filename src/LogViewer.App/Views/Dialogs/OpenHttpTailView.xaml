<Window x:Class="LogViewer.App.Views.Dialogs.OpenHttpTailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LogViewer.App.Localization"
        Title="{loc:Loc Http_Title}"
        Width="520" Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:Loc Http_Url}" />
            <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

            <TextBlock Text="{loc:Loc Http_Mode}" />
            <ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding Mode}" Margin="0,2,0,10" HorizontalAlignment="Left" Width="160" />

            <TextBlock Text="{loc:Loc Http_Headers}" />
            <TextBox Text="{Binding Headers, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"
                     AcceptsReturn="True" TextWrapping="NoWrap" Height="120"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{loc:Loc Common_OK}" Width="80" Margin="0,0,6,0" Click="OnOkClick" IsDefault="True" />
            <Button Content="{loc:Loc Common_Cancel}" Width="80" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
