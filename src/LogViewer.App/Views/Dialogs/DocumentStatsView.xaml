<Window x:Class="LogViewer.App.Views.Dialogs.DocumentStatsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LogViewer.App.Localization"
        Title="{Binding Title, StringFormat={loc:Loc Stats_TitleFmt}}"
        Width="720" Height="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{loc:Loc Stats_TotalLines}" Opacity="0.7" />
                <TextBlock Text="{Binding TotalLines}" FontSize="20" FontWeight="Bold" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{loc:Loc Stats_LinesPerSecond}" Opacity="0.7" />
                <TextBlock Text="{Binding LinesPerSecond, StringFormat=F1}" FontSize="20" FontWeight="Bold" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{loc:Loc Stats_ErrorsWarnings}" Opacity="0.7" />
                <TextBlock FontSize="20" FontWeight="Bold">
                    <Run Text="{Binding ErrorCount}" Foreground="#C0392B" />
                    <Run Text=" / " />
                    <Run Text="{Binding WarningCount}" Foreground="#B8860B" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <ListView Grid.Row="1" ItemsSource="{Binding TopPatterns}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <EventSetter Event="MouseDoubleClick" Handler="OnPatternDoubleClick" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{loc:Loc Stats_Col_Count}" Width="60" DisplayMemberBinding="{Binding Count}" />
                    <GridViewColumn Header="{loc:Loc Stats_Col_Level}" Width="80" DisplayMemberBinding="{Binding Level}" />
                    <GridViewColumn Header="{loc:Loc Stats_Col_FirstLine}" Width="80" DisplayMemberBinding="{Binding FirstLineNumber}" />
                    <GridViewColumn Header="{loc:Loc Stats_Col_Sample}" Width="440" DisplayMemberBinding="{Binding SampleMessage}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{loc:Loc Common_Refresh}" Command="{Binding AnalyzeCommand}" Width="90" Margin="0,0,6,0" />
            <Button Content="{loc:Loc Common_Close}" Width="80" Click="OnCloseClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
