<Window x:Class="LogViewer.App.Views.Dialogs.TraceTreeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:structured="clr-namespace:LogViewer.Core.Structured;assembly=LogViewer.Core"
        xmlns:loc="clr-namespace:LogViewer.App.Localization"
        Title="{Binding Title, StringFormat={loc:Loc TraceTree_TitleFmt}}"
        Width="760" Height="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc TraceTree_TraceLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Traces}" SelectedItem="{Binding SelectedTrace, Mode=TwoWay}"
                      DisplayMemberPath="TraceId" />
            <Button Grid.Column="2" Content="{loc:Loc Common_Refresh}" Command="{Binding RefreshCommand}" Width="90" Margin="8,0,0,0" />
        </Grid>

        <TreeView Grid.Row="1" ItemsSource="{Binding SpanTree}">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="True" />
                    <EventSetter Event="MouseDoubleClick" Handler="OnSpanDoubleClick" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type structured:TraceSpanNode}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="{Binding Level}" FontWeight="Bold" Margin="0,0,8,0" MinWidth="70"
                                   Foreground="{Binding Level, Converter={StaticResource LevelToBrushConverter}}" />
                        <TextBlock Text="{Binding Name}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Duration, Converter={StaticResource SpanDurationToStringConverter}}"
                                   Opacity="0.75" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding SpanKind}" Opacity="0.55" FontStyle="Italic" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{loc:Loc Common_Close}" Width="80" Click="OnCloseClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
