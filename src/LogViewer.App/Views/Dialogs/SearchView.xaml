<Window x:Class="LogViewer.App.Views.Dialogs.SearchView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search"
        Width="640" Height="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding TargetDescription}" Opacity="0.7" Margin="0,0,0,6" />

        <Grid Grid.Row="1" Margin="0,0,0,6" Visibility="{Binding CanSearchByProperty, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Property (blank = whole line):" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" IsEditable="True" Text="{Binding PropertyName, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding WellKnownProperties}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
            <CheckBox Grid.Column="1" Content="Regex" IsChecked="{Binding IsRegex}" VerticalAlignment="Center" Margin="8,0,0,0" />
            <CheckBox Grid.Column="2" Content="Case sensitive" IsChecked="{Binding IsCaseSensitive}" VerticalAlignment="Center" Margin="8,0,0,0" />
            <Button Grid.Column="3" Content="Search" Width="80" Margin="8,0,0,0" Command="{Binding SearchCommand}" />
            <Button Grid.Column="4" Content="Cancel" Width="80" Margin="6,0,0,0" Command="{Binding CancelSearchCommand}" IsEnabled="{Binding IsSearching}" />
        </Grid>

        <ListView Grid.Row="3" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                  Style="{StaticResource LogListViewStyle}"
                  FontFamily="Consolas" FontSize="12" MouseDoubleClick="OnResultsDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Line" Width="80" DisplayMemberBinding="{Binding LineNumber}" />
                    <GridViewColumn Header="Text" Width="500" DisplayMemberBinding="{Binding Text}" />
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,6,0,0" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" Width="80" Click="OnCloseClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
