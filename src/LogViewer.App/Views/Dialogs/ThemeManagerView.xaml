<Window x:Class="LogViewer.App.Views.Dialogs.ThemeManagerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Themes"
        Width="620" Height="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button Content="New" Margin="0,0,0,4" Command="{Binding NewThemeCommand}" />
                <Button Content="Duplicate" Margin="0,0,0,4" Command="{Binding DuplicateCommand}" />
                <Button Content="Delete" Margin="0,0,0,4" Command="{Binding DeleteCommand}" />
                <Button Content="Use This Theme" Command="{Binding UseThemeCommand}" CommandParameter="{Binding SelectedTheme}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Name}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Text" Value="{Binding Name, StringFormat='{}{0} (active)'}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Row="0" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      DataContext="{Binding SelectedTheme}">
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="Name" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsBuiltIn, Converter={StaticResource InverseBoolConverter}}"
                         Margin="0,2,0,4" />
                <TextBlock Text="Built-in themes can't be renamed or recolored — duplicate one to customize it."
                           TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,0,0,10"
                           Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Text="Native controls (menus, dialogs, scrollbars, combo boxes)" Margin="0,0,0,2" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                            IsEnabled="{Binding IsBuiltIn, Converter={StaticResource InverseBoolConverter}}">
                    <RadioButton Content="Light" GroupName="BaseMode" Margin="0,0,16,0"
                                 IsChecked="{Binding BaseMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Light}" />
                    <RadioButton Content="Dark" GroupName="BaseMode"
                                 IsChecked="{Binding BaseMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Dark}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Borders" Width="180" VerticalAlignment="Center" />
                    <TextBox Text="{Binding BorderColorHex, UpdateSourceTrigger=PropertyChanged}" Width="90"
                              IsEnabled="{Binding IsBuiltIn, Converter={StaticResource InverseBoolConverter}}" />
                    <Border Width="24" Height="20" Margin="6,0,0,0" BorderBrush="Gray" BorderThickness="1"
                            Background="{Binding BorderColorHex, Converter={StaticResource HexToBrushConverter}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="MDI workspace background" Width="180" VerticalAlignment="Center" />
                    <TextBox Text="{Binding WorkspaceBackgroundHex, UpdateSourceTrigger=PropertyChanged}" Width="90"
                              IsEnabled="{Binding IsBuiltIn, Converter={StaticResource InverseBoolConverter}}" />
                    <Border Width="24" Height="20" Margin="6,0,0,0" BorderBrush="Gray" BorderThickness="1"
                            Background="{Binding WorkspaceBackgroundHex, Converter={StaticResource HexToBrushConverter}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Log area background" Width="180" VerticalAlignment="Center" />
                    <TextBox Text="{Binding LogBackgroundHex, UpdateSourceTrigger=PropertyChanged}" Width="90"
                              IsEnabled="{Binding IsBuiltIn, Converter={StaticResource InverseBoolConverter}}" />
                    <Border Width="24" Height="20" Margin="6,0,0,0" BorderBrush="Gray" BorderThickness="1"
                            Background="{Binding LogBackgroundHex, Converter={StaticResource HexToBrushConverter}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Log area text" Width="180" VerticalAlignment="Center" />
                    <TextBox Text="{Binding LogForegroundHex, UpdateSourceTrigger=PropertyChanged}" Width="90"
                              IsEnabled="{Binding IsBuiltIn, Converter={StaticResource InverseBoolConverter}}" />
                    <Border Width="24" Height="20" Margin="6,0,0,0" BorderBrush="Gray" BorderThickness="1"
                            Background="{Binding LogForegroundHex, Converter={StaticResource HexToBrushConverter}}" />
                </StackPanel>

                <Border Margin="0,10,0,0" Padding="8" BorderBrush="Gray" BorderThickness="1"
                        Background="{Binding LogBackgroundHex, Converter={StaticResource HexToBrushConverter}}">
                    <TextBlock Text="Preview: sample log line"
                               Foreground="{Binding LogForegroundHex, Converter={StaticResource HexToBrushConverter}}" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Margin="0,0,6,0" Click="OnOkClick" IsDefault="True" />
            <Button Content="Cancel" Width="80" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
