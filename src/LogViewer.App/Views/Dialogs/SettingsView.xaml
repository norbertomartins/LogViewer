<Window x:Class="LogViewer.App.Views.Dialogs.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LogViewer.App.Localization"
        Title="{loc:Loc Settings_Title}"
        Width="380" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
        <StackPanel>
            <TextBlock Text="{loc:Loc Settings_DefaultWindowMode}" />
            <ComboBox ItemsSource="{Binding AvailableWindowModes}" SelectedItem="{Binding DefaultWindowMode}" Margin="0,2,0,10" />

            <TextBlock Text="{loc:Loc Settings_Language}" TextWrapping="Wrap" />
            <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}"
                      DisplayMemberPath="Display" Margin="0,2,0,10" />

            <TextBlock Text="{loc:Loc Settings_RingBufferCapacity}" TextWrapping="Wrap" />
            <TextBox Text="{Binding RingBufferCapacity, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

            <TextBlock Text="{loc:Loc Settings_UiRefreshInterval}" />
            <TextBox Text="{Binding UiRefreshIntervalMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

            <CheckBox IsChecked="{Binding RestorePreviousSessionOnStartup}" Margin="0,0,0,10">
                <TextBlock Text="{loc:Loc Settings_RestoreSession}" TextWrapping="Wrap" />
            </CheckBox>

            <CheckBox IsChecked="{Binding AutoTuneForRemoteDesktop}" Margin="0,0,0,10">
                <TextBlock Text="{loc:Loc Settings_ReduceRedrawRdp}" TextWrapping="Wrap" />
            </CheckBox>

            <CheckBox IsChecked="{Binding ColorizeStructuredValues}" Margin="0,0,0,10">
                <TextBlock Text="{loc:Loc Settings_ColorizeStructured}" TextWrapping="Wrap" />
            </CheckBox>

            <CheckBox IsChecked="{Binding HighlightMatchSpans}" Margin="0,0,0,10">
                <TextBlock Text="{loc:Loc Settings_EmphasizeMatches}" TextWrapping="Wrap" />
            </CheckBox>

            <TextBlock Text="{loc:Loc Settings_LogFontSize}" TextWrapping="Wrap" />
            <TextBox Text="{Binding LogFontSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

            <TextBlock Text="{loc:Loc Settings_Theme}" />
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}"
                          DisplayMemberPath="Name" />
                <Button Grid.Column="2" Content="{loc:Loc Settings_ManageThemes}" Command="{Binding ManageThemesCommand}" />
            </Grid>

            <Separator Margin="0,14,0,10" />

            <CheckBox IsChecked="{Binding McpEnabled}" Margin="0,0,0,10">
                <TextBlock Text="{loc:Loc Settings_McpEnable}" TextWrapping="Wrap" />
            </CheckBox>

            <TextBlock Text="{loc:Loc Settings_McpPort}" TextWrapping="Wrap" />
            <TextBox Text="{Binding McpPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{loc:Loc Common_OK}" Width="80" Margin="0,0,6,0" Click="OnOkClick" IsDefault="True" />
            <Button Content="{loc:Loc Common_Cancel}" Width="80" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
