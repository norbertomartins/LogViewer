<Window x:Class="LogViewer.App.Views.Dialogs.HighlightPresetEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LogViewer.App.Controls"
        Title="Manage Highlight Presets"
        Width="900" Height="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Presets -->
        <DockPanel Grid.Row="0" Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Presets" FontWeight="Bold" Margin="0,0,0,4" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="➕" Margin="0,0,4,0" Command="{Binding AddPresetCommand}" />
                    <Button Content="⧉" Margin="0,0,4,0" Command="{Binding DuplicatePresetCommand}" />
                    <Button Content="🗑" Command="{Binding RemovePresetCommand}" CommandParameter="{Binding SelectedPreset}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="▲" Margin="0,0,4,0" Command="{Binding MovePresetUpCommand}" />
                    <Button Content="▼" Command="{Binding MovePresetDownCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="📤 Export..." Width="86" Margin="0,0,4,0" Click="OnExportSelectedClick" />
                    <Button Content="📤 Export All..." Width="104" Margin="0,0,4,0" Click="OnExportAllClick" />
                </StackPanel>
                <Button Content="📥 Import..." HorizontalAlignment="Left" Width="86" Margin="0,4,0,0" Click="OnImportClick" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Presets}"
                     SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                     DisplayMemberPath="Name" />
        </DockPanel>

        <!-- Rules within the selected preset -->
        <DockPanel Grid.Row="0" Grid.Column="2" DataContext="{Binding SelectedPreset}">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Preset name" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="➕" Margin="0,0,4,0" Command="{Binding AddRuleCommand}" />
                <Button Content="🗑" Margin="0,0,4,0" Command="{Binding RemoveRuleCommand}" CommandParameter="{Binding SelectedRule}" />
                <Button Content="▲" Margin="0,0,4,0" Command="{Binding MoveRuleUpCommand}" ToolTip="Move up" />
                <Button Content="▼" Command="{Binding MoveRuleDownCommand}" ToolTip="Move down" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Rules}"
                     SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                     DisplayMemberPath="Name" />
        </DockPanel>

        <!-- Selected rule detail -->
        <ScrollViewer Grid.Row="0" Grid.Column="4" Padding="0 0 20 0" VerticalScrollBarVisibility="Auto"
                      DataContext="{Binding SelectedPreset.SelectedRule}">
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Text="Name" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

            <TextBlock Text="Pattern (keyword or regex)" />
            <TextBox Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2"
                      BorderBrush="{Binding IsPatternValid, Converter={StaticResource ValidityToBrushConverter}}" BorderThickness="1" />
            <TextBlock Text="Invalid regular expression" Foreground="Red" FontSize="11"
                       Visibility="{Binding IsPatternValid, Converter={StaticResource InverseBoolToVisibilityConverter}}" Margin="0,0,0,8" />

            <CheckBox Content="Regular expression" IsChecked="{Binding IsRegex}" Margin="0,0,0,6" />
            <CheckBox Content="Case sensitive" IsChecked="{Binding IsCaseSensitive}" Margin="0,0,0,6" />
            <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled}" Margin="0,0,0,8" />

            <TextBlock Text="Light theme colors" FontWeight="Bold" Margin="0,0,0,2" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Foreground (#RRGGBB)" />
                    <DockPanel>
                        <controls:ColorPickerButton DockPanel.Dock="Right" Margin="4,0,0,0"
                                                     SelectedHex="{Binding ForegroundHex, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Text="{Binding ForegroundHex, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Background (#RRGGBB)" />
                    <DockPanel>
                        <controls:ColorPickerButton DockPanel.Dock="Right" Margin="4,0,0,0"
                                                     SelectedHex="{Binding BackgroundHex, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Text="{Binding BackgroundHex, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </StackPanel>
            </Grid>
            <Border Padding="8" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,10"
                    Background="{Binding BackgroundHex, Converter={StaticResource HexToBrushConverter}}">
                <TextBlock Text="Preview: sample log line"
                           Foreground="{Binding ForegroundHex, Converter={StaticResource HexToBrushConverter}}" />
            </Border>

            <TextBlock Text="Dark theme colors (blank = same as light)" FontWeight="Bold" Margin="0,0,0,2" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Foreground (#RRGGBB)" />
                    <DockPanel>
                        <controls:ColorPickerButton DockPanel.Dock="Right" Margin="4,0,0,0"
                                                     SelectedHex="{Binding DarkForegroundHex, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Text="{Binding DarkForegroundHex, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Background (#RRGGBB)" />
                    <DockPanel>
                        <controls:ColorPickerButton DockPanel.Dock="Right" Margin="4,0,0,0"
                                                     SelectedHex="{Binding DarkBackgroundHex, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Text="{Binding DarkBackgroundHex, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </StackPanel>
            </Grid>
            <Border Padding="8" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,10"
                    Background="{Binding EffectiveDarkBackgroundHex, Converter={StaticResource HexToBrushConverter}}">
                <TextBlock Text="Preview: sample log line"
                           Foreground="{Binding EffectiveDarkForegroundHex, Converter={StaticResource HexToBrushConverter}}" />
            </Border>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="✔ OK" Width="80" Margin="0,0,6,0" Click="OnOkClick" IsDefault="True" />
            <Button Content="✖ Cancel" Width="80" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
