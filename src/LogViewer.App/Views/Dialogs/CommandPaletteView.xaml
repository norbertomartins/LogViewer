<Window x:Class="LogViewer.App.Views.Dialogs.CommandPaletteView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Palette"
        Width="560" Height="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AutomationProperties.AutomationId="CommandPalette">
    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1"
            Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox x:Name="QueryBox" Grid.Row="0" FontSize="15" Padding="6,5"
                     AutomationProperties.Name="Command palette query"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="OnQueryKeyDown" />

            <ListBox x:Name="ResultList" Grid.Row="1" Margin="0,6,0,0"
                     ItemsSource="{Binding Results}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnResultDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}" />
                                <TextBlock Text="{Binding Hint}" FontSize="11" Opacity="0.6"
                                           Visibility="{Binding Hint, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayCategory}" FontSize="11" Opacity="0.6"
                                       VerticalAlignment="Center" Margin="8,0,4,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
