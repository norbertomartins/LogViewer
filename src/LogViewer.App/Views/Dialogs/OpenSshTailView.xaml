<Window x:Class="LogViewer.App.Views.Dialogs.OpenSshTailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LogViewer.App.Localization"
        Title="{loc:Loc Ssh_Title}"
        Width="560" Height="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="{loc:Loc Ssh_Host}" />
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{loc:Loc Ssh_Port}" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{loc:Loc Ssh_Username}" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                <TextBlock Text="{loc:Loc Ssh_Password}" />
                <PasswordBox x:Name="PasswordBox" Margin="0,2,0,10" PasswordChanged="OnPasswordChanged" />

                <TextBlock Text="{loc:Loc Ssh_PrivateKey}" />
                <TextBox Text="{Binding PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                <TextBlock Text="{loc:Loc Ssh_Passphrase}" />
                <PasswordBox x:Name="PassphraseBox" Margin="0,2,0,10" PasswordChanged="OnPassphraseChanged" />

                <TextBlock Text="{loc:Loc Ssh_RemoteCommand}" />
                <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" FontFamily="Consolas" />

                <TextBlock Text="{loc:Loc Ssh_Fingerprint}" />
                <TextBox Text="{Binding HostKeyFingerprintSha256, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" FontFamily="Consolas" />
                <CheckBox Content="{loc:Loc Ssh_AcceptAnyHostKey}" IsChecked="{Binding AcceptAnyHostKey}" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{loc:Loc Common_OK}" Width="80" Margin="0,0,6,0" Click="OnOkClick" IsDefault="True" />
            <Button Content="{loc:Loc Common_Cancel}" Width="80" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
