<Window x:Class="LogViewer.App.Views.Dialogs.StructuredGridView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LogViewer.App.Localization"
        Title="{Binding Title, StringFormat={loc:Loc Grid_TitleFmt}}"
        Width="1100" Height="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="120" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{loc:Loc Grid_Search}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" VerticalAlignment="Center"
                     AutomationProperties.Name="{loc:Loc Grid_Search}" />
            <CheckBox Content="{loc:Loc Exceptions_Live}" IsChecked="{Binding IsLive}" VerticalAlignment="Center" Margin="16,0,0,0"
                      ToolTip="{loc:Loc Grid_Live_ToolTip}" />
            <ProgressBar Width="120" Height="10" Margin="16,0,0,0" IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <!-- Active value filters, each removable. -->
        <DockPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="{loc:Loc Grid_ClearFilters}" Command="{Binding ClearFiltersCommand}" Padding="8,1" />
            <ItemsControl ItemsSource="{Binding Filters}" AutomationProperties.AutomationId="GridFilters">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,6,2" Padding="6,1" ToolTip="{loc:Loc Grid_RemoveFilter_ToolTip}"
                                Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <TextBlock><Run Text="{Binding Description, Mode=OneWay}" /><Run Text="  ✕" /></TextBlock>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Grid_Columns}" FontWeight="Bold" Margin="0,0,0,4" />
            <ListBox ItemsSource="{Binding PropertyColumns}" AutomationProperties.AutomationId="GridColumnChoices">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsVisible}" AutomationProperties.Name="{Binding Name}">
                            <TextBlock><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" (" Foreground="Gray" /><Run Text="{Binding Count, Mode=OneWay}" Foreground="Gray" /><Run Text=")" Foreground="Gray" /></TextBlock>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" />

        <DataGrid Grid.Row="2" Grid.Column="2" x:Name="EventGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                  CanUserSortColumns="True" CanUserReorderColumns="True" HeadersVisibility="Column"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  FontFamily="Consolas" AutomationProperties.AutomationId="StructuredGrid"
                  Sorting="OnSorting" MouseDoubleClick="OnGridDoubleClick"
                  PreviewMouseRightButtonDown="OnGridPreviewRightClick">
            <DataGrid.ContextMenu>
                <ContextMenu Opened="OnContextMenuOpened">
                    <MenuItem x:Name="FilterByValueItem" Header="{loc:Loc Grid_Ctx_FilterByValue}" Click="OnFilterByValue" />
                    <MenuItem x:Name="ExcludeValueItem" Header="{loc:Loc Grid_Ctx_ExcludeValue}" Click="OnExcludeValue" />
                    <Separator />
                    <MenuItem Header="{loc:Loc Grid_Ctx_GoToLine}" Click="OnGoToLine" />
                    <MenuItem Header="{loc:Loc Grid_Ctx_CopyValue}" Click="OnCopyValue" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{loc:Loc Common_Refresh}" Command="{Binding RefreshCommand}" Width="90" Margin="0,0,6,0" />
                <Button Content="{loc:Loc Common_Close}" Width="80" Click="OnCloseClick" IsCancel="True" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="GridStatus" />
        </DockPanel>
    </Grid>
</Window>
