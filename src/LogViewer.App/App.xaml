<Application x:Class="LogViewer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LogViewer.App.Converters"
             xmlns:controls="clr-namespace:LogViewer.App.Controls"
             xmlns:vm="clr-namespace:LogViewer.App.ViewModels"
             xmlns:views="clr-namespace:LogViewer.App.Views.Documents">
    <Application.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:HexToTabIconConverter x:Key="HexToTabIconConverter" />
        <converters:CustomColorOrTitleBarBrushConverter x:Key="CustomColorOrTitleBarBrushConverter" />
        <converters:ValidityToBrushConverter x:Key="ValidityToBrushConverter" />
        <converters:BookmarkGlyphConverter x:Key="BookmarkGlyphConverter" />
        <converters:LevelToBrushConverter x:Key="LevelToBrushConverter" />
        <converters:TimestampToLocalTimeConverter x:Key="TimestampToLocalTimeConverter" />
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter" />
        <converters:StructuredInlinesConverter x:Key="StructuredInlinesConverter" />
        <converters:HighlightSpanInlinesConverter x:Key="HighlightSpanInlinesConverter" />
        <converters:RegexTestInlinesConverter x:Key="RegexTestInlinesConverter" />
        <converters:VolumeBinBarHeightConverter x:Key="VolumeBinBarHeightConverter" />
        <converters:DiffEntryBrushConverter x:Key="DiffEntryBrushConverter" />

        <!-- Global template: every window-mode host (Tabbed/Floating via AvalonDock, MDI via MdiHostView)
             resolves TailDocumentViewModel through this SAME template, so it's structurally guaranteed
             to be the same view in every mode, not just by convention. -->
        <DataTemplate DataType="{x:Type vm:TailDocumentViewModel}">
            <views:TailDocumentView />
        </DataTemplate>

        <!-- App-specific theme brushes: placeholder Light values so any DynamicResource lookup resolves
             even before ThemeService.Apply runs at startup. ThemeService mutates these SolidColorBrush
             instances' Color in place (rather than replacing them), which is what makes every
             DynamicResource consumer below repaint live when the user switches themes.
             Native chrome (windows, dialogs, menus, scrollbars, combo boxes, buttons, text boxes) is
             NOT styled here — it's governed by Application.ThemeMode (Fluent Light/Dark) in
             ThemeService.Apply, which reaches popup/scrollbar-level chrome these DynamicResource
             brushes couldn't. Only the surfaces the app itself renders are themed here. -->
        <SolidColorBrush x:Key="Theme.BorderColor" Color="#FFACACAC" />
        <SolidColorBrush x:Key="Theme.WorkspaceBackground" Color="#FFDDE3EA" />
        <SolidColorBrush x:Key="Theme.LogBackground" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="Theme.LogForeground" Color="#FF000000" />

        <!-- Default MDI child title-bar fill when a document has no CustomColorHex — theme-aware so a dark
             theme doesn't leave the old light-mode blue clashing with an otherwise dark UI. -->
        <SolidColorBrush x:Key="Theme.TitleBarBackground" Color="#FF3A6EA5" />

        <!-- WPF's Fluent ListView chrome (still experimental in this SDK) doesn't paint its content-area
             fill from the Background property at all, so Theme.LogBackground never reached the space
             below the last row no matter how Background was set. This minimal template takes that one
             layer back under our control — Fluent's scrollbar/selection chrome elsewhere is unaffected,
             only this control's own fill. -->
        <Style x:Key="LogListViewStyle" TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource Theme.LogBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.LogForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListView">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <!-- Without these TemplateBindings, the ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 set on the ListView in TailDocumentView never reaches this nested ScrollViewer (it's
                                 a different object), so it fell back to its own defaults — which don't reserve a
                                 row for the horizontal scrollbar, letting it float on top of the last visible line
                                 instead of pushing content up like a normal ListBox scroll area. -->
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent's default ListViewItem template paints hover/selection as its own accent-colored fill,
             which stomped whatever Background a highlight rule set on the row. This template renders
             Background exactly as bound (via ItemContainerStyle, per-line) in every state — hover/selection
             only ever change BorderBrush/BorderThickness, never the fill. -->
        <Style x:Key="LogListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
